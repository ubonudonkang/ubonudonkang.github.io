<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_TBill" targetNamespace="https://ubonudonkang.com/resources/templates/" exporter="ubonudonkang.com" exporterVersion="1.0">
  <bpmn:documentation>BPMN starter from ubonudonkang.com/resources/templates/. An as-is process for a paper treasury bill request at a fictional bank, from the note What Is a BRD? at ubonudonkang.com/notes/how-to-write-a-brd/. Replace it with your own process.</bpmn:documentation>
  <bpmn:collaboration id="Collab_TBill">
    <bpmn:participant id="Pool_Bank" name="Treasury bill request (as-is)" processRef="Process_TBill_AsIs" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TBill_AsIs" name="Treasury bill request (as-is)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Branch" name="Branch officer">
        <bpmn:flowNodeRef>T_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Treasury" name="Treasury operations">
        <bpmn:flowNodeRef>T_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Settled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Customer wants to invest">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_Fill" name="Fill in paper request form">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Submit" name="Hand form in at branch">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Check" name="Check balance and account status">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Ok" name="Enough balance and account active?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Hold" name="Place hold on account">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Send" name="Send form to treasury">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Reject" name="Receive form back with reason">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Rejected" name="Request rejected">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_Review" name="Review request">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Approve" name="Approve and settle">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Confirm" name="Send confirmation to customer">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Settled" name="Treasury bill settled">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Fill" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_Fill" targetRef="T_Submit" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_Submit" targetRef="T_Check" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_Check" targetRef="G_Ok" />
    <bpmn:sequenceFlow id="F5" name="Yes" sourceRef="G_Ok" targetRef="T_Hold" />
    <bpmn:sequenceFlow id="F6" name="No" sourceRef="G_Ok" targetRef="T_Reject" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_Reject" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F8" sourceRef="T_Hold" targetRef="T_Send" />
    <bpmn:sequenceFlow id="F9" sourceRef="T_Send" targetRef="T_Review" />
    <bpmn:sequenceFlow id="F10" sourceRef="T_Review" targetRef="T_Approve" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_Approve" targetRef="T_Confirm" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_Confirm" targetRef="End_Settled" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_TBill">
      <bpmndi:BPMNShape id="Pool_Bank_di" bpmnElement="Pool_Bank" isHorizontal="true"><dc:Bounds x="160" y="80" width="1260" height="450" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Customer_di" bpmnElement="Lane_Customer" isHorizontal="true"><dc:Bounds x="190" y="80" width="1230" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Branch_di" bpmnElement="Lane_Branch" isHorizontal="true"><dc:Bounds x="190" y="230" width="1230" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Treasury_di" bpmnElement="Lane_Treasury" isHorizontal="true"><dc:Bounds x="190" y="380" width="1230" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="260" y="137" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="233" y="177" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Fill_di" bpmnElement="T_Fill"><dc:Bounds x="330" y="115" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Submit_di" bpmnElement="T_Submit"><dc:Bounds x="490" y="115" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Check_di" bpmnElement="T_Check"><dc:Bounds x="490" y="265" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Ok_di" bpmnElement="G_Ok" isMarkerVisible="true"><dc:Bounds x="640" y="280" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="610" y="334" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Hold_di" bpmnElement="T_Hold"><dc:Bounds x="740" y="265" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Send_di" bpmnElement="T_Send"><dc:Bounds x="890" y="265" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Reject_di" bpmnElement="T_Reject"><dc:Bounds x="630" y="115" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected"><dc:Bounds x="800" y="137" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="773" y="177" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Review_di" bpmnElement="T_Review"><dc:Bounds x="890" y="415" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Approve_di" bpmnElement="T_Approve"><dc:Bounds x="1040" y="415" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Confirm_di" bpmnElement="T_Confirm"><dc:Bounds x="1190" y="415" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Settled_di" bpmnElement="End_Settled"><dc:Bounds x="1332" y="437" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1305" y="477" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="296" y="155" /><di:waypoint x="330" y="155" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="450" y="155" /><di:waypoint x="490" y="155" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="550" y="195" /><di:waypoint x="550" y="265" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="610" y="305" /><di:waypoint x="640" y="305" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="690" y="305" /><di:waypoint x="740" y="305" /><bpmndi:BPMNLabel><dc:Bounds x="702" y="287" width="19" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="665" y="280" /><di:waypoint x="665" y="195" /><bpmndi:BPMNLabel><dc:Bounds x="671" y="240" width="15" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="750" y="155" /><di:waypoint x="800" y="155" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="860" y="305" /><di:waypoint x="890" y="305" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="950" y="345" /><di:waypoint x="950" y="415" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1010" y="455" /><di:waypoint x="1040" y="455" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1160" y="455" /><di:waypoint x="1190" y="455" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1310" y="455" /><di:waypoint x="1332" y="455" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
